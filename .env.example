# ─── Docker / Compose ────────────────────────────────────────────────
APP_PORT=8080
REDIS_PORT=6379

WWW_UID=1000
WWW_GID=1000

# ─── XDebug (PhpStorm) ───────────────────────────────────────────────
XDEBUG_STORM_PORT=9013
XDEBUG_STORM_SERVER_NAME=monitool

# ─── Laravel ─────────────────────────────────────────────────────────
APP_NAME=Monitool
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=monitool
DB_USERNAME=monitool
DB_PASSWORD=secret

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="alerts@monitool.local"
MAIL_FROM_NAME="${APP_NAME}"

# CORS: "*" — будь-який origin; інакше список через кому (https://a.example.com,https://b.example.com)
CORS_ALLOWED_ORIGINS=*

SWAGGER_ENABLE=true
